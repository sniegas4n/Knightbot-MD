RAPHAEL_ENV=development
RAPHAEL_DATABASE_URL=postgresql://raphael:raphael@localhost:5432/raphael
RAPHAEL_CORS_ORIGINS=http://localhost:3000
# Authentification. Si l'instance est accessible publiquement avant la création du compte
# propriétaire, définissez un jeton : il sera demandé sur l'écran de configuration.
RAPHAEL_SETUP_TOKEN=
RAPHAEL_SESSION_TTL_DAYS=30
# Clés des fournisseurs IA (phases 3 à 5) — ne jamais les commiter.
RAPHAEL_LLM_API_KEY=
RAPHAEL_EMBEDDING_API_KEY=
RAPHAEL_VOICE_API_KEY=
