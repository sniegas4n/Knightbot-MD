# Copie ce fichier en .env puis remplis les clés. Le .env n'est jamais commité.

# Clé API Anthropic (sélection des clips, titres) : https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Clé API Deepgram (transcription horodatée au mot, avec locuteurs) : https://console.deepgram.com
DEEPGRAM_API_KEY=

# Phase 3 (publication YouTube) : chemin du fichier OAuth client téléchargé depuis Google Cloud
# YOUTUBE_CLIENT_SECRETS=secrets/client_secret.json
